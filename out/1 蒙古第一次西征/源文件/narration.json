{
  "audio": "D:\\@kaifa\\tushuo\\output\\mongol-west-1-5min\\narration-v3.mp3",
  "duration_s": 300.553,
  "sample_rate": 44100,
  "chunks": [
    {
      "index": 1,
      "text": "四百五十个商人，一夜之间，全没了。",
      "speak": "四百五十个商人，一夜之间，全没了。",
      "chars": 17,
      "duration": 2.973,
      "start": 0.018,
      "end": 2.991,
      "chars_per_sec": 5.72,
      "file": "chunk-001-a6193cb6b083.mp3"
    },
    {
      "index": 2,
      "text": "货抢光，人杀光，消息差点就断在这儿。",
      "speak": "货抢光，人杀光，消息差点就断在这儿。",
      "chars": 18,
      "duration": 3.342,
      "start": 3.021,
      "end": 6.363,
      "chars_per_sec": 5.39,
      "file": "chunk-002-65f6c3bd56a5.mp3"
    },
    {
      "index": 3,
      "text": "动手的，是讹答剌城的一个守将。",
      "speak": "动手的，是讹答腊城的一个守将。",
      "chars": 15,
      "duration": 2.176,
      "start": 6.393,
      "end": 8.569,
      "chars_per_sec": 6.89,
      "file": "chunk-003-f3bdfe33ab44.mp3"
    },
    {
      "index": 4,
      "text": "他以为天高皇帝远，蒙古人拿他没辙。",
      "speak": "他以为天高皇帝远，蒙古人拿他没辙。",
      "chars": 17,
      "duration": 3.285,
      "start": 8.599,
      "end": 11.884,
      "chars_per_sec": 5.17,
      "file": "chunk-004-355d9284ee2b.mp3"
    },
    {
      "index": 5,
      "text": "结果，一座城，换了一个帝国的命。",
      "speak": "结果，一座城，换了一个帝国的命。",
      "chars": 16,
      "duration": 2.831,
      "start": 11.914,
      "end": 14.746,
      "chars_per_sec": 5.65,
      "file": "chunk-005-ed4725adc259.mp3"
    },
    {
      "index": 6,
      "text": "这笔账，是怎么滚起来的？",
      "speak": "这笔账，是怎么滚起来的？",
      "chars": 12,
      "duration": 1.808,
      "start": 14.776,
      "end": 16.583,
      "chars_per_sec": 6.64,
      "file": "chunk-006-54683f31bb2b.mp3"
    },
    {
      "index": 7,
      "text": "那咱把镜头往回倒。",
      "speak": "那咱把镜头往回倒。",
      "chars": 9,
      "duration": 1.209,
      "start": 16.613,
      "end": 17.823,
      "chars_per_sec": 7.44,
      "file": "chunk-007-235f30851a9d.mp3"
    },
    {
      "index": 8,
      "text": "那八百多年前，蒙古草原。",
      "speak": "那八百多年前，蒙古草原。",
      "chars": 12,
      "duration": 2.141,
      "start": 17.853,
      "end": 19.994,
      "chars_per_sec": 5.6,
      "file": "chunk-008-47ac9f8f0eb4.mp3"
    },
    {
      "index": 9,
      "text": "九岁的铁木真，爹被人毒死了。",
      "speak": "九岁的铁木真，爹被人毒死了。",
      "chars": 14,
      "duration": 2.298,
      "start": 20.024,
      "end": 22.322,
      "chars_per_sec": 6.09,
      "file": "chunk-009-6432aa0f7bb8.mp3"
    },
    {
      "index": 10,
      "text": "爹一死，部众跑光，牛羊分光，连口吃的都不给留。",
      "speak": "爹一死，部众跑光，牛羊分光，连口吃的都不给留。",
      "chars": 23,
      "duration": 4.38,
      "start": 22.352,
      "end": 26.732,
      "chars_per_sec": 5.25,
      "file": "chunk-010-853ab1308930.mp3"
    },
    {
      "index": 11,
      "text": "他娘带着几个孩子，挖野菜，捡野果，抓土拨鼠。",
      "speak": "他娘带着几个孩子，挖野菜，捡野果，抓土拨鼠。",
      "chars": 22,
      "duration": 3.755,
      "start": 26.762,
      "end": 30.517,
      "chars_per_sec": 5.86,
      "file": "chunk-011-a10d3d07e757.mp3"
    },
    {
      "index": 12,
      "text": "后来他被俘，脖子上套着木枷，一个部落一个部落地押着走。",
      "speak": "后来他被俘，脖子上套着木枷，一个部落一个部落地押着走。",
      "chars": 27,
      "duration": 4.346,
      "start": 30.547,
      "end": 34.893,
      "chars_per_sec": 6.21,
      "file": "chunk-012-eaf24f4e47a2.mp3"
    },
    {
      "index": 13,
      "text": "再后来，老婆也被人抢了。",
      "speak": "再后来，老婆也被人抢了。",
      "chars": 12,
      "duration": 2.043,
      "start": 34.923,
      "end": 36.966,
      "chars_per_sec": 5.87,
      "file": "chunk-013-32d1dcaf0c88.mp3"
    },
    {
      "index": 14,
      "text": "你琢磨琢磨，这开局，一手烂牌，烂得不能再烂。",
      "speak": "你琢磨琢磨，这开局，一手烂牌，烂得不能再烂。",
      "chars": 22,
      "duration": 3.605,
      "start": 36.996,
      "end": 40.601,
      "chars_per_sec": 6.1,
      "file": "chunk-014-d53e5dd74238.mp3"
    },
    {
      "index": 15,
      "text": "但烂牌打好了，才叫本事。",
      "speak": "但烂牌打好了，才叫本事。",
      "chars": 12,
      "duration": 2.009,
      "start": 40.631,
      "end": 42.64,
      "chars_per_sec": 5.97,
      "file": "chunk-015-69dfcce03fa2.mp3"
    },
    {
      "index": 16,
      "text": "那草原上，部落之间今天结盟，明天捅刀。",
      "speak": "那草原上，部落之间今天结盟，明天捅刀。",
      "chars": 19,
      "duration": 3.705,
      "start": 42.67,
      "end": 46.375,
      "chars_per_sec": 5.13,
      "file": "chunk-016-dc0628388b9f.mp3"
    },
    {
      "index": 17,
      "text": "铁木真最狠的一点，不是能打，是能忍。",
      "speak": "铁木真最狠的一点，不是能打，是能忍。",
      "chars": 18,
      "duration": 2.987,
      "start": 46.405,
      "end": 49.392,
      "chars_per_sec": 6.03,
      "file": "chunk-017-40123ffdd6d5.mp3"
    },
    {
      "index": 18,
      "text": "谁背叛过他，他记着。谁帮过他，他也记着。",
      "speak": "谁背叛过他，他记着。谁帮过他，他也记着。",
      "chars": 20,
      "duration": 3.666,
      "start": 49.422,
      "end": 53.087,
      "chars_per_sec": 5.46,
      "file": "chunk-018-628f345bb5d3.mp3"
    },
    {
      "index": 19,
      "text": "这笔账，他一笔一笔，全记在心里。",
      "speak": "这笔账，他一笔一笔，全记在心里。",
      "chars": 16,
      "duration": 2.815,
      "start": 53.117,
      "end": 55.933,
      "chars_per_sec": 5.68,
      "file": "chunk-019-7d70252d02a9.mp3"
    },
    {
      "index": 20,
      "text": "那他把散掉的部众一点点收回来，把仇人一个个摁下去。",
      "speak": "那他把散掉的部众一点点收回来，把仇人一个个摁下去。",
      "chars": 25,
      "duration": 3.583,
      "start": 55.963,
      "end": 59.546,
      "chars_per_sec": 6.98,
      "file": "chunk-020-a0bf875ae063.mp3"
    },
    {
      "index": 21,
      "text": "1206年，斡难河边，各部首领开会，给他上尊号，成吉思汗。",
      "speak": "一二零六年，斡难河边，各部首领开会，给他上尊号，成吉思罕。",
      "chars": 29,
      "duration": 5.495,
      "start": 59.576,
      "end": 65.071,
      "chars_per_sec": 5.28,
      "file": "chunk-021-b19d4c9b089d.mp3"
    },
    {
      "index": 22,
      "text": "上来第一刀，砍的不是敌人，是部落。",
      "speak": "上来第一刀，砍的不是敌人，是部落。",
      "chars": 17,
      "duration": 2.733,
      "start": 65.101,
      "end": 67.834,
      "chars_per_sec": 6.22,
      "file": "chunk-022-8cfab5af1c1e.mp3"
    },
    {
      "index": 23,
      "text": "管你原来是哪个部，十户、百户、千户、万户，全部打散重编。",
      "speak": "管你原来是哪个部，十户、百户、千户、万户，全部打散重编。",
      "chars": 28,
      "duration": 5.351,
      "start": 67.864,
      "end": 73.215,
      "chars_per_sec": 5.23,
      "file": "chunk-023-c37d05c4b61e.mp3"
    },
    {
      "index": 24,
      "text": "谁也别想再拉山头。",
      "speak": "谁也别想再拉山头。",
      "chars": 9,
      "duration": 1.302,
      "start": 73.245,
      "end": 74.547,
      "chars_per_sec": 6.91,
      "file": "chunk-024-794a228507e4.mp3"
    },
    {
      "index": 25,
      "text": "第二刀，从千户子弟里挑人，组成一万人的怯薛，贴身护卫。",
      "speak": "第二刀，从千户子弟里挑人，组成一万人的怯薛，贴身护卫。",
      "chars": 27,
      "duration": 4.447,
      "start": 74.577,
      "end": 79.024,
      "chars_per_sec": 6.07,
      "file": "chunk-025-4fd46d28893f.mp3"
    },
    {
      "index": 26,
      "text": "第三刀，打仗抢来的东西，先归公，再分。",
      "speak": "第三刀，打仗抢来的东西，先归公，再分。",
      "chars": 19,
      "duration": 3.882,
      "start": 79.054,
      "end": 82.937,
      "chars_per_sec": 4.89,
      "file": "chunk-026-5b69876cddf9.mp3"
    },
    {
      "index": 27,
      "text": "就这三刀，草原上第一次有了台能一直转的战争机器。",
      "speak": "就这三刀，草原上第一次有了台能一直转的战争机器。",
      "chars": 24,
      "duration": 4.077,
      "start": 82.967,
      "end": 87.044,
      "chars_per_sec": 5.89,
      "file": "chunk-027-0a0aa77e4c8e.mp3"
    },
    {
      "index": 28,
      "text": "你注意，这套东西最可怕的地方在哪呢？",
      "speak": "你注意，这套东西最可怕的地方在哪呢？",
      "chars": 18,
      "duration": 3.398,
      "start": 87.074,
      "end": 90.472,
      "chars_per_sec": 5.3,
      "file": "chunk-028-7fca44c658ed.mp3"
    },
    {
      "index": 29,
      "text": "它不靠某一个猛将，它靠制度。",
      "speak": "它不靠某一个猛将，它靠制度。",
      "chars": 14,
      "duration": 2.255,
      "start": 90.502,
      "end": 92.758,
      "chars_per_sec": 6.21,
      "file": "chunk-029-54057f499dc9.mp3"
    },
    {
      "index": 30,
      "text": "千户长死了，换一个，机器照转。",
      "speak": "千户掌死了，换一个，机器照转。",
      "chars": 15,
      "duration": 2.694,
      "start": 92.788,
      "end": 95.481,
      "chars_per_sec": 5.57,
      "file": "chunk-030-eca631017b84.mp3"
    },
    {
      "index": 31,
      "text": "这是草原上从来没出现过的东西。",
      "speak": "这是草原上从来没出现过的东西。",
      "chars": 15,
      "duration": 2.153,
      "start": 95.511,
      "end": 97.665,
      "chars_per_sec": 6.97,
      "file": "chunk-031-27543ac85d45.mp3"
    },
    {
      "index": 32,
      "text": "那机器造好了，得找油。",
      "speak": "那机器造好了，得找油。",
      "chars": 11,
      "duration": 1.989,
      "start": 97.695,
      "end": 99.684,
      "chars_per_sec": 5.53,
      "file": "chunk-032-12914134b171.mp3"
    },
    {
      "index": 33,
      "text": "成吉思汗先没动刀，他动的是商路。",
      "speak": "成吉思罕先没动刀，他动的是商路。",
      "chars": 16,
      "duration": 2.632,
      "start": 99.714,
      "end": 102.346,
      "chars_per_sec": 6.08,
      "file": "chunk-033-29e02eeecc83.mp3"
    },
    {
      "index": 34,
      "text": "他给花剌子模的国王摩诃末带话，咱们做生意，路上我保你平安。",
      "speak": "他给花腊子模的国王摩诃末带话，咱们做生意，路上我保你平安。",
      "chars": 29,
      "duration": 4.502,
      "start": 102.376,
      "end": 106.878,
      "chars_per_sec": 6.44,
      "file": "chunk-034-0f9210dc9eda.mp3"
    },
    {
      "index": 35,
      "text": "1218年，一支商队，四百五十个商人，拉着丝绸、毛皮、金银，进了讹答剌。",
      "speak": "一二一八年，一支商队，四百五十个商人，拉着丝绸、毛皮、金银，进了讹答腊。",
      "chars": 36,
      "duration": 6.643,
      "start": 106.908,
      "end": 113.551,
      "chars_per_sec": 5.42,
      "file": "chunk-035-7898d462fa6d.mp3"
    },
    {
      "index": 36,
      "text": "守将亦纳勒术，是太后的亲戚。",
      "speak": "守将亦纳勒束，是太后的亲戚。",
      "chars": 14,
      "duration": 2.325,
      "start": 113.581,
      "end": 115.906,
      "chars_per_sec": 6.02,
      "file": "chunk-036-e75e6145e5c0.mp3"
    },
    {
      "index": 37,
      "text": "他看着这批货，眼红了。",
      "speak": "他看着这批货，眼红了。",
      "chars": 11,
      "duration": 1.909,
      "start": 115.936,
      "end": 117.845,
      "chars_per_sec": 5.76,
      "file": "chunk-037-146deee92774.mp3"
    },
    {
      "index": 38,
      "text": "上报，这些人是间谍。",
      "speak": "上报，这些人是间谍。",
      "chars": 10,
      "duration": 1.963,
      "start": 117.875,
      "end": 119.838,
      "chars_per_sec": 5.09,
      "file": "chunk-038-18cf80cfc6b0.mp3"
    },
    {
      "index": 39,
      "text": "摩诃末这位老兄，点了头。",
      "speak": "摩诃末这位老兄，点了头。",
      "chars": 12,
      "duration": 1.902,
      "start": 119.868,
      "end": 121.77,
      "chars_per_sec": 6.31,
      "file": "chunk-039-3744df40fee5.mp3"
    },
    {
      "index": 40,
      "text": "他为什么敢呢？",
      "speak": "他为什么敢呢？",
      "chars": 7,
      "duration": 0.857,
      "start": 121.8,
      "end": 122.657,
      "chars_per_sec": 8.17,
      "file": "chunk-040-2f25e07f50d7.mp3"
    },
    {
      "index": 41,
      "text": "因为他觉得，花剌子模兵多，城多，离得又远。",
      "speak": "因为他觉得，花腊子模兵多，城多，离得又远。",
      "chars": 21,
      "duration": 3.99,
      "start": 122.687,
      "end": 126.677,
      "chars_per_sec": 5.26,
      "file": "chunk-041-7ba7bf53ed14.mp3"
    },
    {
      "index": 42,
      "text": "蒙古人再横，还能横过雪山沙漠？",
      "speak": "蒙古人再横，还能横过雪山沙漠？",
      "chars": 15,
      "duration": 2.61,
      "start": 126.707,
      "end": 129.317,
      "chars_per_sec": 5.75,
      "file": "chunk-042-1475007338dc.mp3"
    },
    {
      "index": 43,
      "text": "四百五十个商人，全杀。货，全吞。",
      "speak": "四百五十个商人，全杀。货，全吞。",
      "chars": 16,
      "duration": 3.728,
      "start": 129.347,
      "end": 133.075,
      "chars_per_sec": 4.29,
      "file": "chunk-043-b3ef624c89d9.mp3"
    },
    {
      "index": 44,
      "text": "只有一个牵骆驼的，跑回去报了信。",
      "speak": "只有一个牵骆驼的，跑回去报了信。",
      "chars": 16,
      "duration": 2.074,
      "start": 133.105,
      "end": 135.179,
      "chars_per_sec": 7.71,
      "file": "chunk-044-bfb655981950.mp3"
    },
    {
      "index": 45,
      "text": "那成吉思汗什么反应？",
      "speak": "那成吉思罕什么反应？",
      "chars": 10,
      "duration": 1.386,
      "start": 135.209,
      "end": 136.595,
      "chars_per_sec": 7.21,
      "file": "chunk-045-142b4b9061b3.mp3"
    },
    {
      "index": 46,
      "text": "他先礼后兵。",
      "speak": "他先礼后兵。",
      "chars": 6,
      "duration": 0.898,
      "start": 136.625,
      "end": 137.524,
      "chars_per_sec": 6.68,
      "file": "chunk-046-94d7590db5fb.mp3"
    },
    {
      "index": 47,
      "text": "派三个使者去问，人，为什么杀？货，为什么抢？",
      "speak": "派三个使者去问，人，为什么杀？货，为什么抢？",
      "chars": 22,
      "duration": 4.251,
      "start": 137.554,
      "end": 141.805,
      "chars_per_sec": 5.18,
      "file": "chunk-047-ba90de953a01.mp3"
    },
    {
      "index": 48,
      "text": "摩诃末怎么回的？",
      "speak": "摩诃末怎么回的？",
      "chars": 8,
      "duration": 1.006,
      "start": 141.835,
      "end": 142.841,
      "chars_per_sec": 7.95,
      "file": "chunk-048-7f77382f1b96.mp3"
    },
    {
      "index": 49,
      "text": "杀了正使，把两个副使剃了胡子，赶回去。",
      "speak": "杀了正使，把两个副使剃了胡子，赶回去。",
      "chars": 19,
      "duration": 3.155,
      "start": 142.871,
      "end": 146.026,
      "chars_per_sec": 6.02,
      "file": "chunk-049-e9cf9f6cc0a1.mp3"
    },
    {
      "index": 50,
      "text": "在蒙古人眼里，这比杀人还狠。",
      "speak": "在蒙古人眼里，这比杀人还狠。",
      "chars": 14,
      "duration": 2.534,
      "start": 146.056,
      "end": 148.59,
      "chars_per_sec": 5.52,
      "file": "chunk-050-51eaa59deec7.mp3"
    },
    {
      "index": 51,
      "text": "成吉思汗没吭声。",
      "speak": "成吉思罕没吭声。",
      "chars": 8,
      "duration": 1.319,
      "start": 148.62,
      "end": 149.939,
      "chars_per_sec": 6.06,
      "file": "chunk-051-65f5a8f91cc8.mp3"
    },
    {
      "index": 52,
      "text": "一个人爬上山顶，脱了帽子，跪了三天三夜。",
      "speak": "一个人爬上山顶，脱了帽子，跪了三天三夜。",
      "chars": 20,
      "duration": 3.272,
      "start": 149.969,
      "end": 153.241,
      "chars_per_sec": 6.11,
      "file": "chunk-052-b90349c6bba4.mp3"
    },
    {
      "index": 53,
      "text": "下来以后，就一句话。",
      "speak": "下来以后，就一句话。",
      "chars": 10,
      "duration": 1.869,
      "start": 153.271,
      "end": 155.14,
      "chars_per_sec": 5.35,
      "file": "chunk-053-2b4d26982d6a.mp3"
    },
    {
      "index": 54,
      "text": "准备西征。",
      "speak": "准备西征。",
      "chars": 5,
      "duration": 0.701,
      "start": 155.17,
      "end": 155.871,
      "chars_per_sec": 7.13,
      "file": "chunk-054-63533f29c97a.mp3"
    },
    {
      "index": 55,
      "text": "那西征是拍脑门吗？",
      "speak": "那西征是拍脑门吗？",
      "chars": 9,
      "duration": 1.23,
      "start": 155.901,
      "end": 157.131,
      "chars_per_sec": 7.32,
      "file": "chunk-055-d54ecfd3d5ec.mp3"
    },
    {
      "index": 56,
      "text": "不是。",
      "speak": "不是。",
      "chars": 3,
      "duration": 0.427,
      "start": 157.161,
      "end": 157.589,
      "chars_per_sec": 7.02,
      "file": "chunk-056-01eaf3393d1b.mp3"
    },
    {
      "index": 57,
      "text": "先算账。",
      "speak": "先算账。",
      "chars": 4,
      "duration": 0.646,
      "start": 157.619,
      "end": 158.265,
      "chars_per_sec": 6.19,
      "file": "chunk-057-611a8775c449.mp3"
    },
    {
      "index": 58,
      "text": "路有多远？粮够不够？马够不够？",
      "speak": "路有多远？粮够不够？马够不够？",
      "chars": 15,
      "duration": 2.53,
      "start": 158.295,
      "end": 160.825,
      "chars_per_sec": 5.93,
      "file": "chunk-058-8a9537e8c53e.mp3"
    },
    {
      "index": 59,
      "text": "蒙古骑兵一人好几匹马，换着骑，日行百里。",
      "speak": "蒙古骑兵一人好几匹马，换着骑，日行百里。",
      "chars": 20,
      "duration": 3.695,
      "start": 160.855,
      "end": 164.55,
      "chars_per_sec": 5.41,
      "file": "chunk-059-3da9db504edf.mp3"
    },
    {
      "index": 60,
      "text": "补给线从草原一直拉到中亚，中间隔着雪山和沙漠。",
      "speak": "补给线从草原一直拉到中亚，中间隔着雪山和沙漠。",
      "chars": 23,
      "duration": 3.669,
      "start": 164.58,
      "end": 168.249,
      "chars_per_sec": 6.27,
      "file": "chunk-060-cc3e599b683b.mp3"
    },
    {
      "index": 61,
      "text": "所以他把路先探通，把水草先摸清，把工匠先凑齐。",
      "speak": "所以他把路先探通，把水草先摸清，把工匠先凑齐。",
      "chars": 23,
      "duration": 4.106,
      "start": 168.279,
      "end": 172.385,
      "chars_per_sec": 5.6,
      "file": "chunk-061-71331aebb76d.mp3"
    },
    {
      "index": 62,
      "text": "攻城，光靠骑兵不行，得靠器械。",
      "speak": "攻城，光靠骑兵不行，得靠器械。",
      "chars": 15,
      "duration": 2.971,
      "start": 172.415,
      "end": 175.386,
      "chars_per_sec": 5.05,
      "file": "chunk-062-cbb4e1693b8c.mp3"
    },
    {
      "index": 63,
      "text": "所以每破一座城，工匠不杀，留下造炮。",
      "speak": "所以每破一座城，工匠不杀，留下造炮。",
      "chars": 18,
      "duration": 3.31,
      "start": 175.416,
      "end": 178.726,
      "chars_per_sec": 5.44,
      "file": "chunk-063-04835feb319f.mp3"
    },
    {
      "index": 64,
      "text": "这也是为什么，蒙古人越往后打，破城越快。",
      "speak": "这也是为什么，蒙古人越往后打，破城越快。",
      "chars": 20,
      "duration": 3.217,
      "start": 178.756,
      "end": 181.973,
      "chars_per_sec": 6.22,
      "file": "chunk-064-c9732cb13bec.mp3"
    },
    {
      "index": 65,
      "text": "那花剌子模这边呢？",
      "speak": "那花腊子模这边呢？",
      "chars": 9,
      "duration": 1.207,
      "start": 182.003,
      "end": 183.21,
      "chars_per_sec": 7.45,
      "file": "chunk-065-78d73e41ede9.mp3"
    },
    {
      "index": 66,
      "text": "看着是个帝国，其实是个拼装货。",
      "speak": "看着是个帝国，其实是个拼装货。",
      "chars": 15,
      "duration": 2.361,
      "start": 183.24,
      "end": 185.601,
      "chars_per_sec": 6.35,
      "file": "chunk-066-2bc857df9824.mp3"
    },
    {
      "index": 67,
      "text": "太后一派，国王一派，互相别扭。",
      "speak": "太后一派，国王一派，互相别扭。",
      "chars": 15,
      "duration": 2.836,
      "start": 185.631,
      "end": 188.467,
      "chars_per_sec": 5.29,
      "file": "chunk-067-1404e0812681.mp3"
    },
    {
      "index": 68,
      "text": "号称四十万大军，撒在几百座城里，谁也不想挪窝。",
      "speak": "号称四十万大军，撒在几百座城里，谁也不想挪窝。",
      "chars": 23,
      "duration": 4.025,
      "start": 188.497,
      "end": 192.522,
      "chars_per_sec": 5.71,
      "file": "chunk-068-a5a88f3c5ed7.mp3"
    },
    {
      "index": 69,
      "text": "成吉思汗呢，把拳头攥成一个。",
      "speak": "成吉思罕呢，把拳头攥成一个。",
      "chars": 14,
      "duration": 2.083,
      "start": 192.552,
      "end": 194.635,
      "chars_per_sec": 6.72,
      "file": "chunk-069-884ed113938d.mp3"
    },
    {
      "index": 70,
      "text": "一个攥拳，一个张手。",
      "speak": "一个攥拳，一个张手。",
      "chars": 10,
      "duration": 1.646,
      "start": 194.665,
      "end": 196.311,
      "chars_per_sec": 6.08,
      "file": "chunk-070-01d0ae13e1c7.mp3"
    },
    {
      "index": 71,
      "text": "你说，这仗还怎么打？",
      "speak": "你说，这仗还怎么打？",
      "chars": 10,
      "duration": 1.735,
      "start": 196.341,
      "end": 198.076,
      "chars_per_sec": 5.76,
      "file": "chunk-071-bfe8bd46c898.mp3"
    },
    {
      "index": 72,
      "text": "1219年秋天，大军出发。",
      "speak": "一二一九年秋天，大军出发。",
      "chars": 13,
      "duration": 2.158,
      "start": 198.106,
      "end": 200.263,
      "chars_per_sec": 6.03,
      "file": "chunk-072-aecc8d252a39.mp3"
    },
    {
      "index": 73,
      "text": "先打哪？",
      "speak": "先打哪？",
      "chars": 4,
      "duration": 0.574,
      "start": 200.293,
      "end": 200.868,
      "chars_per_sec": 6.97,
      "file": "chunk-073-19e9f1588451.mp3"
    },
    {
      "index": 74,
      "text": "不挑都城，先打讹答剌，就是杀商队那座城。",
      "speak": "不挑都城，先打讹答腊，就是杀商队那座城。",
      "chars": 20,
      "duration": 3.438,
      "start": 200.898,
      "end": 204.336,
      "chars_per_sec": 5.82,
      "file": "chunk-074-b61be108f348.mp3"
    },
    {
      "index": 75,
      "text": "怎么打？",
      "speak": "怎么打？",
      "chars": 4,
      "duration": 0.537,
      "start": 204.366,
      "end": 204.903,
      "chars_per_sec": 7.45,
      "file": "chunk-075-39b492f96c13.mp3"
    },
    {
      "index": 76,
      "text": "一个字，围。",
      "speak": "一个字，围。",
      "chars": 6,
      "duration": 1.016,
      "start": 204.933,
      "end": 205.949,
      "chars_per_sec": 5.91,
      "file": "chunk-076-859d64aa532f.mp3"
    },
    {
      "index": 77,
      "text": "两个字，死围。",
      "speak": "两个字，死围。",
      "chars": 7,
      "duration": 1.32,
      "start": 205.979,
      "end": 207.298,
      "chars_per_sec": 5.3,
      "file": "chunk-077-0a5d471fd1fc.mp3"
    },
    {
      "index": 78,
      "text": "三个字，往死里围。",
      "speak": "三个字，往死里围。",
      "chars": 9,
      "duration": 1.618,
      "start": 207.328,
      "end": 208.946,
      "chars_per_sec": 5.56,
      "file": "chunk-078-f4e3023a8b87.mp3"
    },
    {
      "index": 79,
      "text": "围了五个月。",
      "speak": "围了五个月。",
      "chars": 6,
      "duration": 0.788,
      "start": 208.976,
      "end": 209.764,
      "chars_per_sec": 7.61,
      "file": "chunk-079-f480853938c8.mp3"
    },
    {
      "index": 80,
      "text": "外城破了，守军退进内堡，又扛了一个月。",
      "speak": "外城破了，守军退进内堡，又扛了一个月。",
      "chars": 19,
      "duration": 3.117,
      "start": 209.794,
      "end": 212.911,
      "chars_per_sec": 6.1,
      "file": "chunk-080-3c7ecc1c98c9.mp3"
    },
    {
      "index": 81,
      "text": "最后弹尽粮绝，城破，亦纳勒术被活捉。",
      "speak": "最后弹尽粮绝，城破，亦纳勒束被活捉。",
      "chars": 18,
      "duration": 4.082,
      "start": 212.941,
      "end": 217.023,
      "chars_per_sec": 4.41,
      "file": "chunk-081-647220e03c58.mp3"
    },
    {
      "index": 82,
      "text": "怎么处置？",
      "speak": "怎么处置？",
      "chars": 5,
      "duration": 0.616,
      "start": 217.053,
      "end": 217.669,
      "chars_per_sec": 8.12,
      "file": "chunk-082-64308a4a3cb4.mp3"
    },
    {
      "index": 83,
      "text": "熔化的银子，灌进他的眼睛和耳朵。",
      "speak": "熔化的银子，灌进他的眼睛和耳朵。",
      "chars": 16,
      "duration": 2.516,
      "start": 217.699,
      "end": 220.214,
      "chars_per_sec": 6.36,
      "file": "chunk-083-b2cb6a53c0d1.mp3"
    },
    {
      "index": 84,
      "text": "你不是爱钱吗？",
      "speak": "你不是爱钱吗？",
      "chars": 7,
      "duration": 0.823,
      "start": 220.244,
      "end": 221.067,
      "chars_per_sec": 8.5,
      "file": "chunk-084-7c14e2de99b0.mp3"
    },
    {
      "index": 85,
      "text": "这回让你一次看个够，听个够。",
      "speak": "这回让你一次看个够，听个够。",
      "chars": 14,
      "duration": 2.062,
      "start": 221.097,
      "end": 223.16,
      "chars_per_sec": 6.79,
      "file": "chunk-085-89ba8672f952.mp3"
    },
    {
      "index": 86,
      "text": "那成吉思汗没在讹答剌停脚。",
      "speak": "那成吉思罕没在讹答腊停脚。",
      "chars": 13,
      "duration": 2.517,
      "start": 223.19,
      "end": 225.707,
      "chars_per_sec": 5.17,
      "file": "chunk-086-faed190f0ada.mp3"
    },
    {
      "index": 87,
      "text": "围城交给两个儿子，自己带着主力，穿过克孜勒库姆沙漠，突然出现在布哈拉城下。",
      "speak": "围城交给两个儿子，自己带着主力，穿过克孜勒库姆沙漠，突然出现在布哈拉城下。",
      "chars": 37,
      "duration": 5.452,
      "start": 225.737,
      "end": 231.188,
      "chars_per_sec": 6.79,
      "file": "chunk-087-502cae86395b.mp3"
    },
    {
      "index": 88,
      "text": "守军都傻了，这鬼地方，怎么可能冒出大军？",
      "speak": "守军都傻了，这鬼地方，怎么可能冒出大军？",
      "chars": 20,
      "duration": 3.548,
      "start": 231.218,
      "end": 234.766,
      "chars_per_sec": 5.64,
      "file": "chunk-088-86daf8d49222.mp3"
    },
    {
      "index": 89,
      "text": "布哈拉开城。",
      "speak": "布哈拉开城。",
      "chars": 6,
      "duration": 0.898,
      "start": 234.796,
      "end": 235.695,
      "chars_per_sec": 6.68,
      "file": "chunk-089-560c2b1e006c.mp3"
    },
    {
      "index": 90,
      "text": "他进了城，站在清真寺里，说了一句话。",
      "speak": "他进了城，站在清真寺里，说了一句话。",
      "chars": 18,
      "duration": 3.022,
      "start": 235.725,
      "end": 238.747,
      "chars_per_sec": 5.96,
      "file": "chunk-090-1f98b1c6fe42.mp3"
    },
    {
      "index": 91,
      "text": "我是上帝之鞭。",
      "speak": "我是上帝之鞭。",
      "chars": 7,
      "duration": 0.916,
      "start": 238.777,
      "end": 239.693,
      "chars_per_sec": 7.64,
      "file": "chunk-091-8b8d891fce83.mp3"
    },
    {
      "index": 92,
      "text": "这句话，史书里有，学界也一直有争论。",
      "speak": "这句话，史书里有，学界也一直有争论。",
      "chars": 18,
      "duration": 3.331,
      "start": 239.723,
      "end": 243.054,
      "chars_per_sec": 5.4,
      "file": "chunk-092-6121564e673c.mp3"
    },
    {
      "index": 93,
      "text": "但接下来的事没争议。",
      "speak": "但接下来的事没争议。",
      "chars": 10,
      "duration": 1.341,
      "start": 243.084,
      "end": 244.426,
      "chars_per_sec": 7.46,
      "file": "chunk-093-4fad7ef4bff9.mp3"
    },
    {
      "index": 94,
      "text": "撒马尔罕，玉龙杰赤，一座接一座，全倒。",
      "speak": "撒马尔罕，玉龙杰赤，一座接一座，全倒。",
      "chars": 19,
      "duration": 4.127,
      "start": 244.456,
      "end": 248.583,
      "chars_per_sec": 4.6,
      "file": "chunk-094-e5a22a0baeae.mp3"
    },
    {
      "index": 95,
      "text": "那摩诃末呢？",
      "speak": "那摩诃末呢？",
      "chars": 6,
      "duration": 0.846,
      "start": 248.613,
      "end": 249.459,
      "chars_per_sec": 7.09,
      "file": "chunk-095-66a5f8a3c65f.mp3"
    },
    {
      "index": 96,
      "text": "一路跑。",
      "speak": "一路跑。",
      "chars": 4,
      "duration": 0.453,
      "start": 249.489,
      "end": 249.942,
      "chars_per_sec": 8.83,
      "file": "chunk-096-b46d74395024.mp3"
    },
    {
      "index": 97,
      "text": "最后跑到里海一个小岛上，病死了。",
      "speak": "最后跑到里海一个小岛上，病死了。",
      "chars": 16,
      "duration": 2.398,
      "start": 249.972,
      "end": 252.37,
      "chars_per_sec": 6.67,
      "file": "chunk-097-2176e76bcd34.mp3"
    },
    {
      "index": 98,
      "text": "死的时候，连件像样的衣服都没有。",
      "speak": "死的时候，连件像样的衣服都没有。",
      "chars": 16,
      "duration": 2.527,
      "start": 252.4,
      "end": 254.927,
      "chars_per_sec": 6.33,
      "file": "chunk-098-8c18b3909874.mp3"
    },
    {
      "index": 99,
      "text": "一个帝国，从开战到君主咽气，不到两年。",
      "speak": "一个帝国，从开战到君主咽气，不到两年。",
      "chars": 19,
      "duration": 3.232,
      "start": 254.957,
      "end": 258.19,
      "chars_per_sec": 5.88,
      "file": "chunk-099-a379d0510c3f.mp3"
    },
    {
      "index": 100,
      "text": "但他儿子扎兰丁，是条硬汉。",
      "speak": "但他儿子扎兰丁，是条硬汉。",
      "chars": 13,
      "duration": 2.29,
      "start": 258.22,
      "end": 260.51,
      "chars_per_sec": 5.68,
      "file": "chunk-100-0daf5bbeb981.mp3"
    },
    {
      "index": 101,
      "text": "八鲁湾，他把一支蒙古偏师打崩了。",
      "speak": "八鲁湾，他把一支蒙古偏师打崩了。",
      "chars": 16,
      "duration": 2.431,
      "start": 260.54,
      "end": 262.971,
      "chars_per_sec": 6.58,
      "file": "chunk-101-d595c9f5b491.mp3"
    },
    {
      "index": 102,
      "text": "这是西征里少见的败仗。",
      "speak": "这是西征里少见的败仗。",
      "chars": 11,
      "duration": 1.578,
      "start": 263.001,
      "end": 264.579,
      "chars_per_sec": 6.97,
      "file": "chunk-102-14412bf01918.mp3"
    },
    {
      "index": 103,
      "text": "成吉思汗亲自来追。",
      "speak": "成吉思罕亲自来追。",
      "chars": 9,
      "duration": 1.868,
      "start": 264.609,
      "end": 266.476,
      "chars_per_sec": 4.82,
      "file": "chunk-103-4ab25c17cd6b.mp3"
    },
    {
      "index": 104,
      "text": "印度河边，扎兰丁被围死。",
      "speak": "印度河边，扎兰丁被围死。",
      "chars": 12,
      "duration": 2.004,
      "start": 266.506,
      "end": 268.511,
      "chars_per_sec": 5.99,
      "file": "chunk-104-a58f614be415.mp3"
    },
    {
      "index": 105,
      "text": "他没降。",
      "speak": "他没投祥。",
      "chars": 4,
      "duration": 0.79,
      "start": 268.541,
      "end": 269.331,
      "chars_per_sec": 5.06,
      "file": "chunk-105-3c62f0aa0826.mp3"
    },
    {
      "index": 106,
      "text": "最后一刻，策马冲下悬崖，连人带马，跳进印度河。",
      "speak": "最后一刻，策马冲下悬崖，连人带马，跳进印度河。",
      "chars": 23,
      "duration": 4.22,
      "start": 269.361,
      "end": 273.581,
      "chars_per_sec": 5.45,
      "file": "chunk-106-b99a76bb5ee3.mp3"
    },
    {
      "index": 107,
      "text": "成吉思汗站在岸上，回头对儿子们说。",
      "speak": "成吉思罕站在岸上，回头对儿子们说。",
      "chars": 17,
      "duration": 2.762,
      "start": 273.611,
      "end": 276.372,
      "chars_per_sec": 6.16,
      "file": "chunk-107-f4b8b23563cc.mp3"
    },
    {
      "index": 108,
      "text": "要学，就学这样的儿子。",
      "speak": "要学，就学这样的儿子。",
      "chars": 11,
      "duration": 1.829,
      "start": 276.402,
      "end": 278.231,
      "chars_per_sec": 6.02,
      "file": "chunk-108-73760fb770ba.mp3"
    },
    {
      "index": 109,
      "text": "那四百五十条人命，最后烧掉了多少？",
      "speak": "那四百五十条人命，最后烧掉了多少？",
      "chars": 17,
      "duration": 2.804,
      "start": 278.261,
      "end": 281.064,
      "chars_per_sec": 6.06,
      "file": "chunk-109-6ce8326df2a5.mp3"
    },
    {
      "index": 110,
      "text": "一座讹答剌，几座都城，一个帝国，几十万条命。",
      "speak": "一座讹答腊，几座都城，一个帝国，几十万条命。",
      "chars": 22,
      "duration": 4.044,
      "start": 281.094,
      "end": 285.138,
      "chars_per_sec": 5.44,
      "file": "chunk-110-7f0648e903f9.mp3"
    },
    {
      "index": 111,
      "text": "而起点，只是一个守将的贪心，和一个国王的傲慢。",
      "speak": "而起点，只是一个守将的贪心，和一个国王的傲慢。",
      "chars": 23,
      "duration": 3.936,
      "start": 285.168,
      "end": 289.104,
      "chars_per_sec": 5.84,
      "file": "chunk-111-92c9c8952a9f.mp3"
    },
    {
      "index": 112,
      "text": "历史有时候就这么不讲道理。",
      "speak": "历史有时候就这么不讲道理。",
      "chars": 13,
      "duration": 1.902,
      "start": 289.134,
      "end": 291.036,
      "chars_per_sec": 6.84,
      "file": "chunk-112-95cef19b6bef.mp3"
    },
    {
      "index": 113,
      "text": "一个小人物的一次贪念，能把整个时代点着。",
      "speak": "一个小人物的一次贪念，能把整个时代点着。",
      "chars": 20,
      "duration": 2.957,
      "start": 291.066,
      "end": 294.023,
      "chars_per_sec": 6.76,
      "file": "chunk-113-1ed4c96aef4a.mp3"
    },
    {
      "index": 114,
      "text": "那问题来了。",
      "speak": "那问题来了。",
      "chars": 6,
      "duration": 0.868,
      "start": 294.053,
      "end": 294.92,
      "chars_per_sec": 6.92,
      "file": "chunk-114-257fdcbd7f79.mp3"
    },
    {
      "index": 115,
      "text": "如果当年，讹答剌的城门开了，商队平安过去了。",
      "speak": "如果当年，讹答腊的城门开了，商队平安过去了。",
      "chars": 22,
      "duration": 3.607,
      "start": 294.95,
      "end": 298.557,
      "chars_per_sec": 6.1,
      "file": "chunk-115-cf33965a6f59.mp3"
    },
    {
      "index": 116,
      "text": "这个世界，会不一样吗？",
      "speak": "这个世界，会不一样吗？",
      "chars": 11,
      "duration": 1.968,
      "start": 298.587,
