[
 {
  "t": 0.018,
  "end": 1.505,
  "text": "四百五十个商人"
 },
 {
  "t": 1.505,
  "end": 2.354,
  "text": "一夜之间"
 },
 {
  "t": 2.354,
  "end": 2.991,
  "text": "全没了"
 },
 {
  "t": 3.021,
  "end": 3.689,
  "text": "货抢光"
 },
 {
  "t": 3.689,
  "end": 4.358,
  "text": "人杀光"
 },
 {
  "t": 4.358,
  "end": 6.363,
  "text": "消息差点就断在这儿"
 },
 {
  "t": 6.393,
  "end": 6.895,
  "text": "动手的"
 },
 {
  "t": 6.895,
  "end": 8.569,
  "text": "是讹答剌城的一个守将"
 },
 {
  "t": 8.599,
  "end": 10.351,
  "text": "他以为天高皇帝远"
 },
 {
  "t": 10.351,
  "end": 11.884,
  "text": "蒙古人拿他没辙"
 },
 {
  "t": 11.914,
  "end": 12.35,
  "text": "结果"
 },
 {
  "t": 12.35,
  "end": 13.003,
  "text": "一座城"
 },
 {
  "t": 13.003,
  "end": 14.746,
  "text": "换了一个帝国的命"
 },
 {
  "t": 14.776,
  "end": 15.318,
  "text": "这笔账"
 },
 {
  "t": 15.318,
  "end": 16.583,
  "text": "是怎么滚起来的"
 },
 {
  "t": 16.613,
  "end": 17.823,
  "text": "那咱把镜头往回倒"
 },
 {
  "t": 17.853,
  "end": 19.138,
  "text": "那八百多年前"
 },
 {
  "t": 19.138,
  "end": 19.994,
  "text": "蒙古草原"
 },
 {
  "t": 20.024,
  "end": 21.173,
  "text": "九岁的铁木真"
 },
 {
  "t": 21.173,
  "end": 22.322,
  "text": "爹被人毒死了"
 },
 {
  "t": 22.352,
  "end": 23.044,
  "text": "爹一死"
 },
 {
  "t": 23.044,
  "end": 23.966,
  "text": "部众跑光"
 },
 {
  "t": 23.966,
  "end": 24.888,
  "text": "牛羊分光"
 },
 {
  "t": 24.888,
  "end": 26.732,
  "text": "连口吃的都不给留"
 },
 {
  "t": 26.762,
  "end": 28.431,
  "text": "他娘带着几个孩子"
 },
 {
  "t": 28.431,
  "end": 29.057,
  "text": "挖野菜"
 },
 {
  "t": 29.057,
  "end": 29.683,
  "text": "捡野果"
 },
 {
  "t": 29.683,
  "end": 30.517,
  "text": "抓土拨鼠"
 },
 {
  "t": 30.547,
  "end": 31.452,
  "text": "后来他被俘"
 },
 {
  "t": 31.452,
  "end": 32.72,
  "text": "脖子上套着木枷"
 },
 {
  "t": 32.72,
  "end": 34.893,
  "text": "一个部落一个部落地押着走"
 },
 {
  "t": 34.923,
  "end": 35.536,
  "text": "再后来"
 },
 {
  "t": 35.536,
  "end": 36.966,
  "text": "老婆也被人抢了"
 },
 {
  "t": 36.996,
  "end": 37.997,
  "text": "你琢磨琢磨"
 },
 {
  "t": 37.997,
  "end": 38.598,
  "text": "这开局"
 },
 {
  "t": 38.598,
  "end": 39.399,
  "text": "一手烂牌"
 },
 {
  "t": 39.399,
  "end": 40.601,
  "text": "烂得不能再烂"
 },
 {
  "t": 40.631,
  "end": 41.836,
  "text": "但烂牌打好了"
 },
 {
  "t": 41.836,
  "end": 42.64,
  "text": "才叫本事"
 },
 {
  "t": 42.67,
  "end": 43.596,
  "text": "那草原上"
 },
 {
  "t": 43.596,
  "end": 45.449,
  "text": "部落之间今天结盟"
 },
 {
  "t": 45.449,
  "end": 46.375,
  "text": "明天捅刀"
 },
 {
  "t": 46.405,
  "end": 47.998,
  "text": "铁木真最狠的一点"
 },
 {
  "t": 47.998,
  "end": 48.795,
  "text": "不是能打"
 },
 {
  "t": 48.795,
  "end": 49.392,
  "text": "是能忍"
 },
 {
  "t": 49.422,
  "end": 50.567,
  "text": "谁背叛过他"
 },
 {
  "t": 50.567,
  "end": 51.255,
  "text": "他记着"
 },
 {
  "t": 51.255,
  "end": 52.171,
  "text": "谁帮过他"
 },
 {
  "t": 52.171,
  "end": 53.087,
  "text": "他也记着"
 },
 {
  "t": 53.117,
  "end": 53.767,
  "text": "这笔账"
 },
 {
  "t": 53.767,
  "end": 54.85,
  "text": "他一笔一笔"
 },
 {
  "t": 54.85,
  "end": 55.933,
  "text": "全记在心里"
 },
 {
  "t": 55.963,
  "end": 58.144,
  "text": "那他把散掉的部众一点点收回来"
 },
 {
  "t": 58.144,
  "end": 59.546,
  "text": "把仇人一个个摁下去"
 },
 {
  "t": 59.576,
  "end": 60.721,
  "text": "1206年"
 },
 {
  "t": 60.721,
  "end": 61.637,
  "text": "斡难河边"
 },
 {
  "t": 61.637,
  "end": 63.01,
  "text": "各部首领开会"
 },
 {
  "t": 63.01,
  "end": 64.155,
  "text": "给他上尊号"
 },
 {
  "t": 64.155,
  "end": 65.071,
  "text": "成吉思汗"
 },
 {
  "t": 65.101,
  "end": 66.077,
  "text": "上来第一刀"
 },
 {
  "t": 66.077,
  "end": 67.248,
  "text": "砍的不是敌人"
 },
 {
  "t": 67.248,
  "end": 67.834,
  "text": "是部落"
 },
 {
  "t": 67.864,
  "end": 69.81,
  "text": "管你原来是哪个部"
 },
 {
  "t": 69.81,
  "end": 71.756,
  "text": "十户百户千户万户"
 },
 {
  "t": 71.756,
  "end": 73.215,
  "text": "全部打散重编"
 },
 {
  "t": 73.245,
  "end": 74.547,
  "text": "谁也别想再拉山头"
 },
 {
  "t": 74.577,
  "end": 75.157,
  "text": "第二刀"
 },
 {
  "t": 75.157,
  "end": 76.704,
  "text": "从千户子弟里挑人"
 },
 {
  "t": 76.704,
  "end": 78.251,
  "text": "组成一万人的怯薛"
 },
 {
  "t": 78.251,
  "end": 79.024,
  "text": "贴身护卫"
 },
 {
  "t": 79.054,
  "end": 79.831,
  "text": "第三刀"
 },
 {
  "t": 79.831,
  "end": 81.643,
  "text": "打仗抢来的东西"
 },
 {
  "t": 81.643,
  "end": 82.419,
  "text": "先归公"
 },
 {
  "t": 82.419,
  "end": 82.937,
  "text": "再分"
 },
 {
  "t": 82.967,
  "end": 83.708,
  "text": "就这三刀"
 },
 {
  "t": 83.708,
  "end": 85.191,
  "text": "草原上第一次有了"
 },
 {
  "t": 85.191,
  "end": 87.044,
  "text": "台能一直转的战争机器"
 },
 {
  "t": 87.074,
  "end": 87.711,
  "text": "你注意"
 },
 {
  "t": 87.711,
  "end": 90.472,
  "text": "这套东西最可怕的地方在哪呢"
 },
 {
  "t": 90.502,
  "end": 92.006,
  "text": "它不靠某一个猛将"
 },
 {
  "t": 92.006,
  "end": 92.758,
  "text": "它靠制度"
 },
 {
  "t": 92.788,
  "end": 93.91,
  "text": "千户长死了"
 },
 {
  "t": 93.91,
  "end": 94.583,
  "text": "换一个"
 },
 {
  "t": 94.583,
  "end": 95.481,
  "text": "机器照转"
 },
 {
  "t": 95.511,
  "end": 97.665,
  "text": "这是草原上从来没出现过的东西"
 },
 {
  "t": 97.695,
  "end": 99.021,
  "text": "那机器造好了"
 },
 {
  "t": 99.021,
  "end": 99.684,
  "text": "得找油"
 },
 {
  "t": 99.714,
  "end": 101.218,
  "text": "成吉思汗先没动刀"
 },
 {
  "t": 101.218,
  "end": 102.346,
  "text": "他动的是商路"
 },
 {
  "t": 102.376,
  "end": 104.8,
  "text": "他给花剌子模的国王摩诃末带话"
 },
 {
  "t": 104.8,
  "end": 105.666,
  "text": "咱们做生意"
 },
 {
  "t": 105.666,
  "end": 106.878,
  "text": "路上我保你平安"
 },
 {
  "t": 106.908,
  "end": 108.053,
  "text": "1218年"
 },
 {
  "t": 108.053,
  "end": 108.97,
  "text": "一支商队"
 },
 {
  "t": 108.97,
  "end": 110.573,
  "text": "四百五十个商人"
 },
 {
  "t": 110.573,
  "end": 112.406,
  "text": "拉着丝绸毛皮金银"
 },
 {
  "t": 112.406,
  "end": 113.551,
  "text": "进了讹答剌"
 },
 {
  "t": 113.581,
  "end": 114.744,
  "text": "守将亦纳勒术"
 },
 {
  "t": 114.744,
  "end": 115.906,
  "text": "是太后的亲戚"
 },
 {
  "t": 115.936,
  "end": 117.209,
  "text": "他看着这批货"
 },
 {
  "t": 117.209,
  "end": 117.845,
  "text": "眼红了"
 },
 {
  "t": 117.875,
  "end": 118.366,
  "text": "上报"
 },
 {
  "t": 118.366,
  "end": 119.838,
  "text": "这些人是间谍"
 },
 {
  "t": 119.868,
  "end": 121.199,
  "text": "摩诃末这位老兄"
 },
 {
  "t": 121.199,
  "end": 121.77,
  "text": "点了头"
 },
 {
  "t": 121.8,
  "end": 122.657,
  "text": "他为什么敢呢"
 },
 {
  "t": 122.687,
  "end": 123.861,
  "text": "因为他觉得"
 },
 {
  "t": 123.861,
  "end": 125.269,
  "text": "花剌子模兵多"
 },
 {
  "t": 125.269,
  "end": 125.738,
  "text": "城多"
 },
 {
  "t": 125.738,
  "end": 126.677,
  "text": "离得又远"
 },
 {
  "t": 126.707,
  "end": 127.711,
  "text": "蒙古人再横"
 },
 {
  "t": 127.711,
  "end": 129.317,
  "text": "还能横过雪山沙漠"
 },
 {
  "t": 129.347,
  "end": 131.522,
  "text": "四百五十个商人"
 },
 {
  "t": 131.522,
  "end": 132.143,
  "text": "全杀"
 },
 {
  "t": 132.143,
  "end": 132.454,
  "text": "货"
 },
 {
  "t": 132.454,
  "end": 133.075,
  "text": "全吞"
 },
 {
  "t": 133.105,
  "end": 134.29,
  "text": "只有一个牵骆驼的"
 },
 {
  "t": 134.29,
  "end": 135.179,
  "text": "跑回去报了信"
 },
 {
  "t": 135.209,
  "end": 136.595,
  "text": "那成吉思汗什么反应"
 },
 {
  "t": 136.625,
  "end": 137.524,
  "text": "他先礼后兵"
 },
 {
  "t": 137.554,
  "end": 139.304,
  "text": "派三个使者去问"
 },
 {
  "t": 139.304,
  "end": 139.554,
  "text": "人"
 },
 {
  "t": 139.554,
  "end": 140.555,
  "text": "为什么杀"
 },
 {
  "t": 140.555,
  "end": 140.805,
  "text": "货"
 },
 {
  "t": 140.805,
  "end": 141.805,
  "text": "为什么抢"
 },
 {
  "t": 141.835,
  "end": 142.841,
  "text": "摩诃末怎么回的"
 },
 {
  "t": 142.871,
  "end": 143.66,
  "text": "杀了正使"
 },
 {
  "t": 143.66,
  "end": 145.434,
  "text": "把两个副使剃了胡子"
 },
 {
  "t": 145.434,
  "end": 146.026,
  "text": "赶回去"
 },
 {
  "t": 146.056,
  "end": 147.323,
  "text": "在蒙古人眼里"
 },
 {
  "t": 147.323,
  "end": 148.59,
  "text": "这比杀人还狠"
 },
 {
  "t": 148.62,
  "end": 149.939,
  "text": "成吉思汗没吭声"
 },
 {
  "t": 149.969,
  "end": 151.316,
  "text": "一个人爬上山顶"
 },
 {
  "t": 151.316,
  "end": 152.086,
  "text": "脱了帽子"
 },
 {
  "t": 152.086,
  "end": 153.241,
  "text": "跪了三天三夜"
 },
 {
  "t": 153.271,
  "end": 154.205,
  "text": "下来以后"
 },
 {
  "t": 154.205,
  "end": 155.14,
  "text": "就一句话"
 },
 {
  "t": 155.17,
  "end": 155.871,
  "text": "准备西征"
 },
 {
  "t": 155.901,
  "end": 157.131,
  "text": "那西征是拍脑门吗"
 },
 {
  "t": 157.161,
  "end": 157.589,
  "text": "不是"
 },
 {
  "t": 157.619,
  "end": 158.265,
  "text": "先算账"
 },
 {
  "t": 158.295,
  "end": 159.138,
  "text": "路有多远"
 },
 {
  "t": 159.138,
  "end": 159.982,
  "text": "粮够不够"
 },
 {
  "t": 159.982,
  "end": 160.825,
  "text": "马够不够"
 },
 {
  "t": 160.855,
  "end": 163.029,
  "text": "蒙古骑兵一人好几匹马"
 },
 {
  "t": 163.029,
  "end": 163.681,
  "text": "换着骑"
 },
 {
  "t": 163.681,
  "end": 164.55,
  "text": "日行百里"
 },
 {
  "t": 164.58,
  "end": 166.677,
  "text": "补给线从草原一直拉到中亚"
 },
 {
  "t": 166.677,
  "end": 168.249,
  "text": "中间隔着雪山和沙漠"
 },
 {
  "t": 168.279,
  "end": 169.921,
  "text": "所以他把路先探通"
 },
 {
  "t": 169.921,
  "end": 171.153,
  "text": "把水草先摸清"
 },
 {
  "t": 171.153,
  "end": 172.385,
  "text": "把工匠先凑齐"
 },
 {
  "t": 172.415,
  "end": 172.91,
  "text": "攻城"
 },
 {
  "t": 172.91,
  "end": 174.396,
  "text": "光靠骑兵不行"
 },
 {
  "t": 174.396,
  "end": 175.386,
  "text": "得靠器械"
 },
 {
  "t": 175.416,
  "end": 176.961,
  "text": "所以每破一座城"
 },
 {
  "t": 176.961,
  "end": 177.843,
  "text": "工匠不杀"
 },
 {
  "t": 177.843,
  "end": 178.726,
  "text": "留下造炮"
 },
 {
  "t": 178.756,
  "end": 179.891,
  "text": "这也是为什么"
 },
 {
  "t": 179.891,
  "end": 181.216,
  "text": "蒙古人越往后打"
 },
 {
  "t": 181.216,
  "end": 181.973,
  "text": "破城越快"
 },
 {
  "t": 182.003,
  "end": 183.21,
  "text": "那花剌子模这边呢"
 },
 {
  "t": 183.24,
  "end": 184.33,
  "text": "看着是个帝国"
 },
 {
  "t": 184.33,
  "end": 185.601,
  "text": "其实是个拼装货"
 },
 {
  "t": 185.631,
  "end": 186.576,
  "text": "太后一派"
 },
 {
  "t": 186.576,
  "end": 187.522,
  "text": "国王一派"
 },
 {
  "t": 187.522,
  "end": 188.467,
  "text": "互相别扭"
 },
 {
  "t": 188.497,
  "end": 189.906,
  "text": "号称四十万大军"
 },
 {
  "t": 189.906,
  "end": 191.315,
  "text": "撒在几百座城里"
 },
 {
  "t": 191.315,
  "end": 192.522,
  "text": "谁也不想挪窝"
 },
 {
  "t": 192.552,
  "end": 193.42,
  "text": "成吉思汗呢"
 },
 {
  "t": 193.42,
  "end": 194.635,
  "text": "把拳头攥成一个"
 },
 {
  "t": 194.665,
  "end": 195.488,
  "text": "一个攥拳"
 },
 {
  "t": 195.488,
  "end": 196.311,
  "text": "一个张手"
 },
 {
  "t": 196.341,
  "end": 196.775,
  "text": "你说"
 },
 {
  "t": 196.775,
  "end": 198.076,
  "text": "这仗还怎么打"
 },
 {
  "t": 198.106,
  "end": 199.479,
  "text": "1219年秋天"
 },
 {
  "t": 199.479,
  "end": 200.263,
  "text": "大军出发"
 },
 {
  "t": 200.293,
  "end": 200.868,
  "text": "先打哪"
 },
 {
  "t": 200.898,
  "end": 201.707,
  "text": "不挑都城"
 },
 {
  "t": 201.707,
  "end": 202.718,
  "text": "先打讹答剌"
 },
 {
  "t": 202.718,
  "end": 204.336,
  "text": "就是杀商队那座城"
 },
 {
  "t": 204.366,
  "end": 204.903,
  "text": "怎么打"
 },
 {
  "t": 204.933,
  "end": 205.695,
  "text": "一个字"
 },
 {
  "t": 205.695,
  "end": 205.949,
  "text": "围"
 },
 {
  "t": 205.979,
  "end": 206.77,
  "text": "两个字"
 },
 {
  "t": 206.77,
  "end": 207.298,
  "text": "死围"
 },
 {
  "t": 207.328,
  "end": 208.021,
  "text": "三个字"
 },
 {
  "t": 208.021,
  "end": 208.946,
  "text": "往死里围"
 },
 {
  "t": 208.976,
  "end": 209.764,
  "text": "围了五个月"
 },
 {
  "t": 209.794,
  "end": 210.573,
  "text": "外城破了"
 },
 {
  "t": 210.573,
  "end": 211.742,
  "text": "守军退进内堡"
 },
 {
  "t": 211.742,
  "end": 212.911,
  "text": "又扛了一个月"
 },
 {
  "t": 212.941,
  "end": 214.574,
  "text": "最后弹尽粮绝"
 },
 {
  "t": 214.574,
  "end": 215.118,
  "text": "城破"
 },
 {
  "t": 215.118,
  "end": 217.023,
  "text": "亦纳勒术被活捉"
 },
 {
  "t": 217.053,
  "end": 217.669,
  "text": "怎么处置"
 },
 {
  "t": 217.699,
  "end": 218.597,
  "text": "熔化的银子"
 },
 {
  "t": 218.597,
  "end": 220.214,
  "text": "灌进他的眼睛和耳朵"
 },
 {
  "t": 220.244,
  "end": 221.067,
  "text": "你不是爱钱吗"
 },
 {
  "t": 221.097,
  "end": 222.644,
  "text": "这回让你一次看个够"
 },
 {
  "t": 222.644,
  "end": 223.16,
  "text": "听个够"
 },
 {
  "t": 223.19,
  "end": 225.707,
  "text": "那成吉思汗没在讹答剌停脚"
 },
 {
  "t": 225.737,
  "end": 227.058,
  "text": "围城交给两个儿子"
 },
 {
  "t": 227.058,
  "end": 228.05,
  "text": "自己带着主力"
 },
 {
  "t": 228.05,
  "end": 229.536,
  "text": "穿过克孜勒库姆沙漠"
 },
 {
  "t": 229.536,
  "end": 231.188,
  "text": "突然出现在布哈拉城下"
 },
 {
  "t": 231.218,
  "end": 232.262,
  "text": "守军都傻了"
 },
 {
  "t": 232.262,
  "end": 233.096,
  "text": "这鬼地方"
 },
 {
  "t": 233.096,
  "end": 234.766,
  "text": "怎么可能冒出大军"
 },
 {
  "t": 234.796,
  "end": 235.695,
  "text": "布哈拉开城"
 },
 {
  "t": 235.725,
  "end": 236.531,
  "text": "他进了城"
 },
 {
  "t": 236.531,
  "end": 237.74,
  "text": "站在清真寺里"
 },
 {
  "t": 237.74,
  "end": 238.747,
  "text": "说了一句话"
 },
 {
  "t": 238.777,
  "end": 239.693,
  "text": "我是上帝之鞭"
 },
 {
  "t": 239.723,
  "end": 240.389,
  "text": "这句话"
 },
 {
  "t": 240.389,
  "end": 241.277,
  "text": "史书里有"
 },
 {
  "t": 241.277,
  "end": 243.054,
  "text": "学界也一直有争论"
 },
 {
  "t": 243.084,
  "end": 244.426,
  "text": "但接下来的事没争议"
 },
 {
  "t": 244.456,
  "end": 245.557,
  "text": "撒马尔罕"
 },
 {
  "t": 245.557,
  "end": 246.657,
  "text": "玉龙杰赤"
 },
 {
  "t": 246.657,
  "end": 248.033,
  "text": "一座接一座"
 },
 {
  "t": 248.033,
  "end": 248.583,
  "text": "全倒"
 },
 {
  "t": 248.613,
  "end": 249.459,
  "text": "那摩诃末呢"
 },
 {
  "t": 249.489,
  "end": 249.942,
  "text": "一路跑"
 },
 {
  "t": 249.972,
  "end": 251.856,
  "text": "最后跑到里海一个小岛上"
 },
 {
  "t": 251.856,
  "end": 252.37,
  "text": "病死了"
 },
 {
  "t": 252.4,
  "end": 253.122,
  "text": "死的时候"
 },
 {
  "t": 253.122,
  "end": 254.927,
  "text": "连件像样的衣服都没有"
 },
 {
  "t": 254.957,
  "end": 255.765,
  "text": "一个帝国"
 },
 {
  "t": 255.765,
  "end": 257.382,
  "text": "从开战到君主咽气"
 },
 {
  "t": 257.382,
  "end": 258.19,
  "text": "不到两年"
 },
 {
  "t": 258.22,
  "end": 259.677,
  "text": "但他儿子扎兰丁"
 },
 {
  "t": 259.677,
  "end": 260.51,
  "text": "是条硬汉"
 },
 {
  "t": 260.54,
  "end": 261.061,
  "text": "八鲁湾"
 },
 {
  "t": 261.061,
  "end": 262.971,
  "text": "他把一支蒙古偏师打崩了"
 },
 {
  "t": 263.001,
  "end": 264.579,
  "text": "这是西征里少见的败仗"
 },
 {
  "t": 264.609,
  "end": 266.476,
  "text": "成吉思汗亲自来追"
 },
 {
  "t": 266.506,
  "end": 267.308,
  "text": "印度河边"
 },
 {
  "t": 267.308,
  "end": 268.511,
  "text": "扎兰丁被围死"
 },
 {
  "t": 268.541,
  "end": 269.331,
  "text": "他没降"
 },
 {
  "t": 269.361,
  "end": 270.249,
  "text": "最后一刻"
 },
 {
  "t": 270.249,
  "end": 271.582,
  "text": "策马冲下悬崖"
 },
 {
  "t": 271.582,
  "end": 272.47,
  "text": "连人带马"
 },
 {
  "t": 272.47,
  "end": 273.581,
  "text": "跳进印度河"
 },
 {
  "t": 273.611,
  "end": 275.084,
  "text": "成吉思汗站在岸上"
 },
 {
  "t": 275.084,
  "end": 276.372,
  "text": "回头对儿子们说"
 },
 {
  "t": 276.402,
  "end": 276.808,
  "text": "要学"
 },
 {
  "t": 276.808,
  "end": 278.231,
  "text": "就学这样的儿子"
 },
 {
  "t": 278.261,
  "end": 279.756,
  "text": "那四百五十条人命"
 },
 {
  "t": 279.756,
  "end": 281.064,
  "text": "最后烧掉了多少"
 },
 {
  "t": 281.094,
  "end": 282.217,
  "text": "一座讹答剌"
 },
 {
  "t": 282.217,
  "end": 283.116,
  "text": "几座都城"
 },
 {
  "t": 283.116,
  "end": 284.015,
  "text": "一个帝国"
 },
 {
  "t": 284.015,
  "end": 285.138,
  "text": "几十万条命"
 },
 {
  "t": 285.168,
  "end": 285.758,
  "text": "而起点"
 },
 {
  "t": 285.758,
  "end": 287.53,
  "text": "只是一个守将的贪心"
 },
 {
  "t": 287.53,
  "end": 289.104,
  "text": "和一个国王的傲慢"
 },
 {
  "t": 289.134,
  "end": 291.036,
  "text": "历史有时候就这么不讲道理"
 },
 {
  "t": 291.066,
  "end": 292.709,
  "text": "一个小人物的一次贪念"
 },
 {
  "t": 292.709,
  "end": 294.023,
  "text": "能把整个时代点着"
 },
 {
  "t": 294.053,
  "end": 294.92,
  "text": "那问题来了"
 },
 {
  "t": 294.95,
  "end": 295.709,
  "text": "如果当年"
 },
 {
  "t": 295.709,
  "end": 297.228,
  "text": "讹答剌的城门开了"
 },
 {
  "t": 297.228,
  "end": 298.557,
  "text": "商队平安过去了"
 },
 {
  "t": 298.587,
  "end": 299.462,
  "text": "这个世界"
 },
 {
  "t": 299.462,
  "end": 300.555,
  "text": "会不一样吗"
 }
]