[
  {
    "t": 0.0,
    "end": 1.22,
    "text": "四百五十个商人",
    "chunk": 1
  },
  {
    "t": 1.25,
    "end": 2.4,
    "text": "走进讹答剌城",
    "chunk": 1
  },
  {
    "t": 2.43,
    "end": 3.26,
    "text": "他们带的货",
    "chunk": 1
  },
  {
    "t": 3.29,
    "end": 4.72,
    "text": "成了他们的催命符",
    "chunk": 1
  },
  {
    "t": 4.75,
    "end": 5.78,
    "text": "一二一八年",
    "chunk": 1
  },
  {
    "t": 5.81,
    "end": 7.74,
    "text": "一支蒙古商队带着金银",
    "chunk": 1
  },
  {
    "t": 7.77,
    "end": 8.6,
    "text": "丝绸和毛皮",
    "chunk": 1
  },
  {
    "t": 8.63,
    "end": 10.042,
    "text": "来到花剌子模的边城",
    "chunk": 1
  },
  {
    "t": 10.17,
    "end": 12.06,
    "text": "守将亦纳勒术说他们是间谍",
    "chunk": 2
  },
  {
    "t": 12.09,
    "end": 13.54,
    "text": "杀了人 吞了货",
    "chunk": 2
  },
  {
    "t": 13.57,
    "end": 14.72,
    "text": "消息传回草原",
    "chunk": 2
  },
  {
    "t": 14.75,
    "end": 16.56,
    "text": "成吉思汗先派三名使者",
    "chunk": 2
  },
  {
    "t": 16.59,
    "end": 17.48,
    "text": "把人交出来",
    "chunk": 2
  },
  {
    "t": 17.51,
    "end": 19.24,
    "text": "苏丹摩诃末的回答是",
    "chunk": 2
  },
  {
    "t": 19.27,
    "end": 20.865,
    "text": "杀正使 辱副使",
    "chunk": 2
  },
  {
    "t": 20.99,
    "end": 22.0,
    "text": "那时的摩诃末",
    "chunk": 3
  },
  {
    "t": 22.03,
    "end": 23.4,
    "text": "刚把帝国推到顶点",
    "chunk": 3
  },
  {
    "t": 23.43,
    "end": 25.14,
    "text": "没把东方的蒙古放在眼里",
    "chunk": 3
  },
  {
    "t": 25.17,
    "end": 26.46,
    "text": "一二一九年秋",
    "chunk": 3
  },
  {
    "t": 26.55,
    "end": 27.28,
    "text": "蒙古军西进",
    "chunk": 3
  },
  {
    "t": 27.31,
    "end": 28.68,
    "text": "讹答剌被围了五个月",
    "chunk": 3
  },
  {
    "t": 28.71,
    "end": 30.46,
    "text": "外城 内堡先后陷落",
    "chunk": 3
  },
  {
    "t": 30.49,
    "end": 31.527,
    "text": "亦纳勒术被擒",
    "chunk": 3
  },
  {
    "t": 31.61,
    "end": 33.607,
    "text": "志费尼记下 熔银灌眼",
    "chunk": 4
  },
  {
    "t": 33.71,
    "end": 35.96,
    "text": "布哈拉 撒马尔罕接连陷落",
    "chunk": 5
  },
  {
    "t": 35.99,
    "end": 37.26,
    "text": "摩诃末一路西逃",
    "chunk": 5
  },
  {
    "t": 37.29,
    "end": 38.62,
    "text": "一二二零年冬天",
    "chunk": 5
  },
  {
    "t": 38.65,
    "end": 39.9,
    "text": "死在里海的孤岛上",
    "chunk": 5
  },
  {
    "t": 39.93,
    "end": 41.24,
    "text": "一座边城的劫案",
    "chunk": 5
  },
  {
    "t": 41.27,
    "end": 42.779,
    "text": "为什么能拖垮一个帝国",
    "chunk": 5
  },
  {
    "t": 42.83,
    "end": 44.36,
    "text": "因为讹答剌是导火索",
    "chunk": 6
  },
  {
    "t": 44.39,
    "end": 46.18,
    "text": "火药桶是分裂的朝堂",
    "chunk": 6
  },
  {
    "t": 46.21,
    "end": 47.2,
    "text": "漫长的商路",
    "chunk": 6
  },
  {
    "t": 47.23,
    "end": 49.06,
    "text": "和一台已经启动的战争机器",
    "chunk": 6
  },
  {
    "t": 49.09,
    "end": 50.46,
    "text": "这是蒙古第一次西征",
    "chunk": 6
  },
  {
    "t": 50.49,
    "end": 51.98,
    "text": "讹答剌点着了导火索",
    "chunk": 6
  },
  {
    "t": 52.01,
    "end": 53.7,
    "text": "但火药桶 早就埋好了",
    "chunk": 6
  }
]